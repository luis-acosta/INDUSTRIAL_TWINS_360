{
  "name": "industrial-twins-360",
  "version": "0.52.0",
  "private": true,
  "description": "INDUSTRIAL TWINS 360 — Plataforma de recorridos virtuales industriales para Windows",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/tokens",
    "packages/domain",
    "packages/persistence",
    "packages/ui",
    "packages/viewer",
    "packages/tour",
    "packages/editor",
    "packages/exporter",
    "apps/desktop",
    "apps/viewer-web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @it360/desktop",
    "dev:viewer": "npm run dev --workspace @it360/viewer-web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "fixtures": "node tests/fixtures/generate-fixtures.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "verify": "npm run typecheck && npm run verify:wasm && npm run verify:access && npm run test && npm run test:server && npm run test:stitcher",
    "report": "node tools/test-report.mjs",
    "verify:wasm": "node tools/verify-wasm.mjs",
    "build:viewer": "npm run build --workspace @it360/viewer-web",
    "access:emit": "node tools/emit-access-model.mjs",
    "verify:access": "node tools/emit-access-model.mjs --check",
    "test:server": "python3 -m pytest apps/server",
    "test:stitcher": "python3 -m pytest services/stitcher"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@tauri-apps/cli": "2.1.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "^0.172.0",
    "@types/webxr": "^0.5.20",
    "@typescript-eslint/eslint-plugin": "8.19.1",
    "@typescript-eslint/parser": "8.19.1",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "5.1.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
