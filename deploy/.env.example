# Configuración del servicio INDUSTRIAL TWINS 360 (X20)
#
# Copie este archivo a «.env» junto al compose y rellene los valores. Todas las
# variables llevan el prefijo IT360_, que es el que lee el servicio: una prueba
# comprueba que los nombres de este archivo son exactamente los que el código
# busca, porque la deriva entre la documentación y el código es el fallo de
# despliegue más difícil de encontrar —el servicio arranca, ignora la variable y
# se comporta como si no estuviera configurada—.
#
# Nada de este archivo debe entrar en el repositorio del cliente. El compose lo
# lee del disco y no lo copia a ninguna imagen.

# --- Base de datos (obligatoria) -------------------------------------------
# El servicio no crea la base: la espera creada y con permisos del usuario.
IT360_DATABASE_URL=postgresql://it360:CAMBIEME@db:5432/it360

# --- Orígenes autorizados --------------------------------------------------
# Separados por comas. Vacío = ninguno, que es lo correcto cuando el recorrido
# se sirve desde el mismo servidor que el servicio: sin CORS no hace falta
# autorizar a nadie. Rellénelo sólo si el recorrido vive en otro dominio.
IT360_ALLOWED_ORIGINS=

# --- Telemetría (opcional) -------------------------------------------------
# Sólo si algún recorrido muestra datos de proceso en vivo.
# EL TOKEN DEBE SER DE SOLO LECTURA EN INFLUXDB. El servicio rechaza toda
# consulta que no sea de lectura, pero ésa es la segunda barrera; la primera es
# que la credencial no pueda escribir ni aunque alguien se equivoque.
#IT360_INFLUX_URL=https://influx.planta.local:8086
#IT360_INFLUX_ORG=planta-norte
#IT360_INFLUX_BUCKET=proceso
#IT360_INFLUX_TOKEN=
#IT360_INFLUX_TIMEOUT_SECONDS=8
# Si el historiador usa un certificado interno puede desactivar la verificación,
# pero el servicio exige que declare el motivo y no arranca sin él: una
# desactivación silenciosa de TLS es una puerta abierta que nadie recuerda.
#IT360_INFLUX_VERIFY_TLS=false
#IT360_INFLUX_TLS_EXEMPTION_REASON=

# Archivo con las variables de proceso autorizadas. Es una LISTA BLANCA: el
# servicio sólo consulta las que estén aquí, y sin archivo los extremos de
# telemetría contestan 503. Eso es deliberado y preferible a arrancar
# permitiendo cualquier consulta contra el historiador de la planta.
#IT360_MAPPINGS_FILE=/etc/it360/variables.json

# --- Correo de avisos (opcional) -------------------------------------------
# Sin esto, los avisos se encolan y se declaran NO entregados, y el editor se lo
# dice al autor. Muchas plantas no dejan salir SMTP de la red de proceso; ése es
# un despliegue legítimo y el producto no finge haber avisado a nadie.
#IT360_SMTP_HOST=smtp.cliente.local
#IT360_SMTP_PORT=587
#IT360_SMTP_SENDER=it360@cliente.local
#IT360_SMTP_USERNAME=
#IT360_SMTP_PASSWORD=
#IT360_SMTP_USE_TLS=true
#IT360_SMTP_TIMEOUT_SECONDS=10

# --- Operación -------------------------------------------------------------
IT360_TELEMETRY_CACHE_SECONDS=15
IT360_BACKUP_DIR=/var/lib/it360/backups
IT360_ENVIRONMENT=production
